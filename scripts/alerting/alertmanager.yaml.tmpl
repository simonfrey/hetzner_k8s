# Alertmanager config, rendered by scripts/create-alerting-secrets.sh into the
# "alertmanager-config" secret (monitoring namespace). Kept out of gitops/
# because the Telegram chat ID must be inline and this repo is public.
# After editing: re-run the script (the config-reloader picks it up).
route:
  receiver: telegram
  group_by: ['alertname', 'namespace']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: "null"
      matchers:
        - alertname = "Watchdog"
    - receiver: "null"
      matchers:
        - alertname = "InfoInhibitor"
    - receiver: "null"
      matchers:
        - alertname = "KubePdbNotEnoughHealthyPods"
        - poddisruptionbudget =~ ".*critical-op-pdb"
receivers:
  - name: "null"
  - name: telegram
    telegram_configs:
      - bot_token: "${TELEGRAM_BOT_TOKEN}"
        chat_id: ${TELEGRAM_CHAT_ID}
        send_resolved: true
        parse_mode: HTML
        # One block per alert: status + name, where, what, runbook.
        # "html" escapes label/annotation text (Telegram rejects stray <, >, &).
        message: |-
          {{ range .Alerts -}}
          {{ if eq .Status "resolved" }}✅ <b>RESOLVED</b>{{ else if eq .Labels.severity "critical" }}🔴 <b>CRITICAL</b>{{ else }}🟠 <b>WARNING</b>{{ end }} · <b>{{ .Labels.alertname | html }}</b>
          {{ with .Labels.namespace }}📦 {{ . | html }}{{ end }}{{ with .Labels.pod }} / <code>{{ . | html }}</code>{{ end }}{{ with .Labels.persistentvolumeclaim }} / <code>{{ . | html }}</code>{{ end }}{{ with .Labels.node }} 🖥 {{ . | html }}{{ end }}
          {{ with .Annotations.description }}{{ . | html }}{{ else }}{{ .Annotations.summary | html }}{{ end }}
          {{ with .Annotations.runbook_url }}<a href="{{ . }}">Runbook</a>{{ end }}

          {{ end }}
