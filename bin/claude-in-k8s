#!/usr/bin/env bash
#
# claude-in-k8s — attach to a persistent Claude Code pod from any local directory.
#
# Syncs the current working directory to the pod via mutagen (using kubectl
# exec/cp transport from k8s-mutagen-transport), then opens an interactive
# Claude session. Conversations resume per-project thanks to stable workspace
# paths derived from the local directory hash.
#
# Prerequisites:
#   - kubectl configured for the target cluster
#   - mutagen installed (yay -S mutagen.io-bin)
#   - k8s-mutagen-transport cloned and set up:
#       git clone https://github.com/rooty0/k8s-mutagen-transport ~/.local/share/k8s-mutagen-transport
#       cd ~/.local/share/k8s-mutagen-transport && uv sync
#
set -euo pipefail

# --- Configuration (override via environment) ---
NS="${CCK8S_NAMESPACE:-claude-code}"
DEPLOY="${CCK8S_DEPLOY:-claude-code}"
CONTAINER="${CCK8S_CONTAINER:-claude-code}"
TRANSPORT_PATH="${CCK8S_TRANSPORT_PATH:-$HOME/.local/share/k8s-mutagen-transport}"

# --- Derived values ---
SESSION_ID=$(printf '%s' "$PWD" | sha256sum | cut -c1-12)
REMOTE_PATH="/workspaces/${SESSION_ID}"
SESSION_NAME="cck8s-${SESSION_ID}"

cleanup() {
  echo ""
  echo "Cleaning up..."
  if mutagen sync list "$SESSION_NAME" &>/dev/null; then
    mutagen sync terminate "$SESSION_NAME" 2>/dev/null || true
  fi
}
trap cleanup EXIT

# --- Preflight checks ---
for cmd in kubectl mutagen python3; do
  command -v "$cmd" &>/dev/null || { echo "Error: $cmd not found in PATH"; exit 1; }
done

if [ ! -d "$TRANSPORT_PATH" ] || [ ! -f "$TRANSPORT_PATH/ssh" ]; then
  echo "Error: k8s-mutagen-transport not found at $TRANSPORT_PATH"
  echo "Install it:"
  echo "  git clone https://github.com/rooty0/k8s-mutagen-transport $TRANSPORT_PATH"
  echo "  cd $TRANSPORT_PATH && uv sync"
  exit 1
fi

# --- Ensure mutagen daemon uses the k8s transport ---
# The daemon inherits MUTAGEN_SSH_PATH from when it was started. If it's not
# set or points elsewhere, restart the daemon with the correct value.
CURRENT_SSH_PATH=$(mutagen daemon run -- printenv MUTAGEN_SSH_PATH 2>/dev/null || true)
if [ "$CURRENT_SSH_PATH" != "$TRANSPORT_PATH" ]; then
  echo "Configuring mutagen daemon for k8s transport..."
  mutagen daemon stop 2>/dev/null || true
  export MUTAGEN_SSH_PATH="$TRANSPORT_PATH"
  mutagen daemon start
fi

# --- Find the pod ---
echo "Finding claude-code pod..."
POD=$(kubectl -n "$NS" get pod -l "app=$DEPLOY" --field-selector=status.phase=Running \
  -o jsonpath='{.items[0].metadata.name}' 2>/dev/null) || true

if [ -z "$POD" ]; then
  echo "Error: No running claude-code pod found in namespace $NS"
  exit 1
fi
echo "Pod: $POD"

# --- Ensure remote workspace directory exists ---
kubectl -n "$NS" exec "$POD" -c "$CONTAINER" -- mkdir -p "$REMOTE_PATH"

# --- Start mutagen sync ---
MUTAGEN_BETA="k8s--${POD}.${NS}:${REMOTE_PATH}"
echo "Syncing $PWD -> $MUTAGEN_BETA (session: $SESSION_NAME)..."

if mutagen sync list "$SESSION_NAME" &>/dev/null; then
  echo "Resuming existing mutagen session..."
  mutagen sync resume "$SESSION_NAME" 2>/dev/null || true
else
  mutagen sync create \
    --name "$SESSION_NAME" \
    --sync-mode=two-way-resolved \
    --ignore=node_modules \
    --ignore=.venv \
    --ignore=__pycache__ \
    --ignore=.git \
    --default-file-mode=0644 \
    --default-directory-mode=0755 \
    "$PWD" \
    "$MUTAGEN_BETA"
fi

# Wait for initial sync to complete
echo "Waiting for initial sync..."
mutagen sync flush "$SESSION_NAME"
echo "Sync ready."

# --- Attach interactive Claude session ---
echo ""
echo "Project: $PWD"
echo "Remote:  $REMOTE_PATH"
echo "Session: $SESSION_ID"
echo "---"
echo ""

kubectl -n "$NS" exec -it -c "$CONTAINER" "$POD" -- \
  bash -lc "cd '${REMOTE_PATH}' && claude -c --dangerously-skip-permissions"
